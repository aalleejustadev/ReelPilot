{
  "name": "reelpilot",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"npm run dev\" \"npm run worker:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "sh -c 'prisma migrate dev \"$@\" && prisma generate' --",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "storage:cors": "tsx --env-file-if-exists=.env scripts/storage-cors.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.63",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-presigned-post": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@base-ui/react": "^1.8.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@remotion/player": "4.0.529",
    "ai": "^7.0.114",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ffmpeg-static": "^5.3.0",
    "files-sdk": "^2.6.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "node-html-parser": "^9.0.4",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529",
    "resend": "^6.29.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@neon/config": "^1.7.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-call": "^1.4.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "mysql2": "^3.23.1",
    "deepmerge-ts": "^8.0.0",
    "sharp": "^0.35.4"
  }
}
